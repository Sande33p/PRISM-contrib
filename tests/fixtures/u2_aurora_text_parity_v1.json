      "cancelled",
      "error"
    ],
    "aggregate_policy": "No majority vote or averaging away a failure; retain per-case/per-repetition/per-dtype verdicts.",
    "uncertainty": "Two deterministic repeats detect instability only; no confidence interval, generalization, speed, quality or real-model claim from CPU fixtures.",
    "amendment_policy": "New version and pre-result review; retain prior artifact hashes, failed evidence and original verdict."
  },
