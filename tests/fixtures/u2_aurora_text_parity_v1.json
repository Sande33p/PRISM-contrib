    "observation_policy": "Independent hooks at actual forward entry and return; include zero-quota steps. No reconstruction from planned loop counts. Preserve partial starts and unknown totals after errors.",
    "zero_quota_diagnostics": "Capture raw logits on every returned forward. Upstream computes candidates/confidence even at zero quota; if PRISM skips them, independently derive and label diagnostic-only values from captured logits without claiming runtime selection.",
    "index_convention": "Zero-based absolute sequence indices include prefix and one BOA; compare reveal sets per block/step, not their internal order.",
    "sidecars": "All current-block raw logits, including previously revealed rows and every vocabulary column, must remain available for numeric checks. Hash-only or sampled columns are insufficient. Validate shape, byte size, containment and content hash.",
    "stop_semantics": "Check EOA after all scheduled steps of a completed block; exclude first EOA and trailing tokens from output. Preserve decoded block and EOA offset. Never commit a partial block."
  },
  "tie_policy": {
    "reveal_comparison": "set_equality",
    "duplicate_indices": "fail",
    "argmax": "preserve actual upstream argmax; record exact maxima and winning token",
    "selection": "preserve actual upstream topk; do not stabilize or sort before selecting",
    "boundary": "Record kth and next eligible confidence plus all indices exactly tied at kth; null boundary margin when k=0 or k equals eligible count. Masked sentinel positions are ineligible.",
    "near_tie": "gap <= atol + rtol * max(abs(left), abs(right)); use raw-logit thresholds for top-two token gaps and confidence thresholds for kth-boundary gaps",
    "divergence_even_if_tied": "fail",
    "near_tie_is_exception": false
  },
  "numeric_tolerances": {
    "rule": "For every compared finite scalar, abs(prism - oracle) <= atol + rtol * abs(oracle); no averaging or percentage allowance.",
    "comparison_precision": "Convert captured values to float64 for diagnostics; retain original dtype and bytes. Compare raw logits and pre-masking candidate probabilities from softmax(logits.to(float64)).",
    "float32": {
      "raw_logits": {
        "atol": 1e-05,
        "rtol": 1e-05
      },
      "candidate_confidence": {
        "atol": 1e-06,
        "rtol": 1e-05
      }
    },
    "float16": {
