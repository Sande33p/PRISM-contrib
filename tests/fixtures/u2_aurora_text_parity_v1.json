        "atol": 0.02,
        "rtol": 0.02
      },
      "candidate_confidence": {
        "atol": 0.002,
        "rtol": 0.02
      }
    },
    "nonfinite_logits_or_diagnostics": "fail",
    "structural_negative_infinity": "Only masked/ineligible confidence sentinels; exact matching locations required, excluded from finite numeric reductions.",
    "required_summaries": [
      "compared_scalar_count",
      "max_absolute_error",
      "max_relative_error_nonzero_oracle",
      "max_normalized_error",
      "violation_count",
      "first_violation",
      "minimum_argmax_margin",
      "minimum_selection_boundary_margin",
      "tie_count"
    ],
    "max_normalized_error": "max(abs(prism-oracle)/(atol+rtol*abs(oracle))) must be <= 1.",
    "rationale": "Predeclared diagnostic bounds ordered by mantissa precision; they are ceilings, not observed accuracy. Exact discrete agreement remains mandatory. No calibration or relaxation after measurements."
  },
  "verdict": {
    "pass": "All required cases and both repetitions satisfy identity, trace, numeric, discrete and coverage criteria in the primary dtype, with complete successful receipts and reviewed exact-revision evidence. Optional dtypes are separately labeled.",
    "fail": "Any observed identity, discrete, nonfinite, numeric or repeatability violation; preserve first divergence and all failures.",
    "incomplete": "Missing evidence or coverage, unavailable instrumentation, unsupported runtime, OOM, cancellation, budget exhaustion, execution error or missing exit/result receipt. Known violations remain failures even if evidence is also incomplete.",
    "successful_finish_reasons": [
      "eoa",
      "length"
